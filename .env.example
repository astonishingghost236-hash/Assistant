# OpenRouter API key: https://openrouter.ai/settings/keys
LLM_API_KEY=

# OpenRouter-compatible endpoint and model IDs. For OpenAI direct, use
# https://api.openai.com/v1, gpt-4o-mini, and whisper-1 instead.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
LLM_TRANSCRIPTION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
PORT=3001
